<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\CleanArchStarter.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    PRINCIPLE(static-analysis-enforced-invariant): ErrorProne.NET.CoreAnalyzers (EPC13)
    fails the build on a discarded Result/Result<T>.

    PRINCIPLE(core-must-not-depend-on-framework): this project references only Domain and
    an analyzer — no framework package. Wiring the use cases into DI lives in the Api
    project (CompositionRoot.cs).
  -->
  <ItemGroup>
    <PackageReference Include="ErrorProne.NET.CoreAnalyzers" Version="0.9.0-beta.4" PrivateAssets="all" IncludeAssets="analyzers;build" />
  </ItemGroup>

</Project>
